DATABASE_URL=postgres://postgres:postgres@localhost:5432/tdog_nest_development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Used by the S3 presigner (GET /v1/sessions/:id/presigned_download).
# Presigning is a local signature computation, not a network call, so
# any non-empty values work for local dev/tests without real AWS access.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
S3_BUCKET=fake

# BullMQ job queue (clip requests enqueued by POST /v1/sessions/:id/stop).
REDIS_URL=redis://localhost:6379

# Signs/verifies the recorder <-> API JWTs (POST /v1/recorders/heartbeat,
# /webhook, and the outbound call made by the clip-request job).
JWT_SECRET=change-me

# External recorder service (not part of this repo). Defaults to
# http://localhost:4000 if unset.
RECORDER_URL=http://localhost:4000

# Used to build the callback_url sent to the recorder service, and the
# success_url/cancel_url for Stripe Checkout.
APP_BASE_URL=http://localhost:3000

# Stripe. Checkout session creation (POST /v1/payments/checkout) is a real
# API call and needs a real test-mode secret key to work; webhook signature
# verification (POST /v1/webhooks/stripe) is a local computation, so any
# non-empty STRIPE_WEBHOOK_SECRET works for local dev/tests.
STRIPE_SECRET_KEY=sk_test_fake
STRIPE_PRICE_ID=price_fake
STRIPE_WEBHOOK_SECRET=whsec_fake
