DATABASE_URL=postgres://postgres:postgres@localhost:5432/tdog_nest_development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Used by the S3 presigner (GET /v1/sessions/:id/presigned_download).
# Presigning is a local signature computation, not a network call, so
# any non-empty values work for local dev/tests without real AWS access.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
S3_BUCKET=fake
